<!DOCTYPE html>
<html>
<head>
    <title>Student Login</title>
</head>
<body>
    <h2>Student Login</h2>
    <% if (message) { %>
        <p style="color: red;"><%= message %></p>
    <% } %>
    <form action="/login" method="POST">
        <label>User ID:</label>
        <input
            type="text"
            name="userId"
            placeholder="Enter user ID"
            required
        >
        <br><br>
        <label>Passcode:</label>
        <input
            type="password"
            name="passcode"
            placeholder="Enter passcode"
            required
        >
        <br><br>
        <button type="submit">Sign In</button>
    </form>
    <p>
        Demo login: <b>student</b> / <b>456</b>
    </p>
</body>
</html>